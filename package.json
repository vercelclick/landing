{
  "name": "cloud",
  "version": "0.2.8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "dev:vinext": "vite dev --port 3000",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker cloud-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.2.0",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "posthog-js": "^1.438.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "react-shiki": "^0.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "babel-plugin-react-compiler": "1.0.0",
    "cf": "^1.0.0-rc.1",
    "oxc-transform-react": "^0.158.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vinext": "^1.4.6",
    "vite": "8.3.0",
    "wrangler": "^4.156.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module"
}