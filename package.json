{
  "name": "cloud",
  "version": "0.2.8",
  "private": true,
  "scripts": {
    "dev": "bun run generate:docs && next dev",
    "build": "bun run generate:docs && next build",
    "generate:docs": "node scripts/generate-docs.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "deploy": "bun run generate:docs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "bun run generate:docs && opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.2.0",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "posthog-js": "^1.438.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "react-shiki": "^0.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "wrangler": "^4.156.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module"
}